# --- Required ---------------------------------------------------------------
# Your SiteVero app (no trailing slash). The worker calls $SITEVERO_URL/api/public/worker
SITEVERO_URL=https://sitevero-privacy-accessibility.lovable.app
# Must equal the WORKER_SECRET set in the SiteVero (Lovable Cloud) environment
WORKER_SECRET=change-me-long-random-string

# --- Screenshots -------------------------------------------------------------
# Screenshots are uploaded through the app's signed "upload_url" action: no database key needed.
# Only for older app versions without upload_url (not recommended):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Mode -------------------------------------------------------------------
# true = process all queued scans, then exit (Cloud Run Jobs, cron). false = run forever and poll.
RUN_ONCE=false

# --- Tuning (defaults shown) -----------------------------------------------
WORKER_CONCURRENCY=1
POLL_INTERVAL_MS=15000
SCAN_TIMEOUT_MS=720000
HEARTBEAT_MS=60000
MAX_PAGES=10
SETTLE_MS=4000
NAV_TIMEOUT_MS=45000
CHAT_WAIT_MS=20000
MEDIA_PAGES=5
# Send the "coverage" object ("What we tested": pages, scenarios run, what could not be tested).
# On by default; set to false only for an app version that rejects it.
SEND_COVERAGE=true

# --- Regions (optional) ----------------------------------------------------
# Without a proxy, scans use the region's language and time zone but the worker's own IP address.
# PROXY_EU_FR=http://user:pass@fr.proxy.example:8000
# PROXY_DE=
# PROXY_UK=
# PROXY_US_CA=

# Browser identity. Default is a normal desktop Chrome user agent, so sites behave as for real visitors.
# SCAN_USER_AGENT=
# Also set PORT (e.g. 8080) on platforms that require an HTTP health check.
